{
  "name": "tkt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.12.0",
  "description": "터미널에서 카카오톡 채팅방 하나를 주고받는 TUI",
  "bin": "./dist/cli.js",
  "scripts": {
    "dev": "yarn build:native && tsx src/cli.tsx",
    "build": "yarn build:native && tsc",
    "start": "yarn build:native && node dist/cli.js",
    "build:native": "swiftc -O native/tkt-ax.swift -o native/tkt-ax"
  },
  "dependencies": {
    "ink": "^5.1.0",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
